{
  "schema_version": 1,
  "id": "antigravity",
  "display_name": "Google Antigravity / Gemini",
  "cli": {
    "commands": ["antigravity", "agy"],
    "auth_hints": [".config/antigravity"]
  },
  "cliproxy": {
    "provider": "antigravity",
    "login_flag": "--antigravity-login",
    "auth_file_prefixes": ["antigravity-"]
  },
  "models": [
    {
      "key": "gemini-primary",
      "candidates": [
        "gemini-3.6-flash-high",
        "gemini-3.5-flash-low",
        "gemini-3-flash",
        "gemini-3.1-pro-low",
        "gemini-3.1-flash-lite"
      ],
      "patterns": ["^gemini-[0-9.]+-flash(?:-(?:high|low|extra-low))?$"],
      "codebuddy": {
        "supportsToolCall": true,
        "supportsImages": true,
        "supportsReasoning": true
      }
    },
    {
      "key": "gemini-3-flash",
      "candidates": ["gemini-3-flash"],
      "patterns": ["^gemini-3-flash$"],
      "optional": true,
