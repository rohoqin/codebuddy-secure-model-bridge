{
  "schema_version": 1,
  "id": "antigravity",
  "display_name": "Google Antigravity / Gemini / Claude",
  "cli": {
    "commands": ["antigravity", "agy"],
    "auth_hints": [".config/antigravity"]
  },
  "cliproxy": {
    "provider": "antigravity",
    "login_flag": "--antigravity-login",
    "auth_file_prefixes": ["antigravity-"]
  },
  "model_catalogs": [
    {
      "path": ".config/antigravity/cliproxyapi-catalog.json",
      "format": "json",
      "id_fields": ["id"],
      "input_fields": ["context_window"],
      "output_fields": ["max_output_tokens"]
    }
  ],
  "models": [
    {
      "key": "gemini-3-flash",
      "candidates": ["gemini-3-flash"],
      "codebuddy": {
        "supportsToolCall": true,
        "supportsImages": true,
        "supportsReasoning": true
      }
    },
    {
      "key": "gemini-3-flash-agent",
      "candidates": ["gemini-3-flash-agent"],
      "codebuddy": {
        "supportsToolCall": true,
        "supportsImages": true,
        "supportsReasoning": true
      }
    },
    {
      "key": "gemini-3.1-flash-image",
      "candidates": ["gemini-3.1-flash-image"],
